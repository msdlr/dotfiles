#!/usr/bin/env sh

# Clone a repo and then let the user choose which branches to deploy as worktrees (main branch holds the .git directory)

# $1: repo URL
# $2: clone path

print () {
    if [ "$(uname)" = Darwin ]
    then
        printf "$1\n"
    else
        echo "$1"
    fi
}

if [ "$#" -lt 1 ]
then 
    echo "Usage:
    $0 <repo URL>
    $0 <repo URL> <clone path>"
    exit 1
fi

CLONE_URL="$1"
CLONE_DST="$2"
CLONE_DST="${CLONE_DST:=$(basename "${CLONE_URL%.tex}")}"

# Clone repo in /tmp directory to get the main branch
tmp_dir=$(mktemp -d)
mkdir -pv "${tmp_dir}"
mkdir -pv "${CLONE_DST}"
git clone "${CLONE_URL}" "${tmp_dir}"
main_branch=$(git -C "${tmp_dir}" rev-parse --abbrev-ref HEAD)

# Move the main branch to the destination
rm -rf "${CLONE_DST}/${main_branch}"
mv "${tmp_dir}" "${CLONE_DST}/${main_branch}"

branches=$(git -C "${CLONE_DST}/${main_branch}" ls-remote --heads origin | awk '{print $2}' | sed 's#refs/heads/##' | fzf --reverse -m --prompt="Select branch(es)> ")

for branch in ${branches}
do
    git -C "${CLONE_DST}/${main_branch}" worktree add "${CLONE_DST}/$branch" "$branch" && 
    print "\e[32m${CLONE_DST}/${branch}/ -> origin/${branch}\e[39m"
done