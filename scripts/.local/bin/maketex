#!/usr/bin/env sh

if [ "$#" -eq 0 ]; then
	echo "Usage: maketex <file.tex>"
	exit 1
fi

# If multiple files are passed, process independenly in parallel
if [ "$#" -gt 1 ]; then
	for file in "$@"; do
		if [ -f "$file" ]; then
			$0 "$file" &
		fi
	done
	wait
fi

tmpdir=".tex"

tex_command="latexmk -pdf -synctex=1 -interaction=nonstopmode -output-directory=$tmpdir -aux-directory=$tmpdir"

if [ ! -f "$1" ]; then
	if [ -f "$1".tex ]; then
		exec $0 "$1".tex
	else
		echo "File $1 or $1.tex not found"
		exit 1
	fi
fi

more_passes=0

if [ -f "$1" ]; then
	file="$(realpath "$1")"
	prefix="${file%.tex}"
	dir="$(dirname "$file")"
	name="$(basename "$prefix")"

	cd "$dir" || exit 1 
	mkdir -p $tmpdir

	$tex_command "$file" || exit 1

	if [ ! -s "$tmpdir/$name.bbl" ]; then
    	biber --input-directory "$tmpdir" --output-directory "$tmpdir" "$name" || exit 1
		more_passes=1
	fi

	if latexdiff --flatten "$file" "$file" | grep -n 'usepackage.*{glossaries}' 2>/dev/null; then
		makeglossaries -d "$tmpdir" "$name" || exit 1
		more_passes=1
	fi

	if [ "$more_passes" != 0 ]; then
		$tex_command "$file" || exit 1
	fi

	mv "$tmpdir/$name.pdf" "$dir/"

else
	# If number of parameters is 0, print usage
	if [ "$#" -eq 0 ]; then
		echo "Usage: maketex <file.tex>"
		return 1
	fi
	echo "File '$1' not found!"
	return 1
fi
