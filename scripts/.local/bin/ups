#!/usr/bin/env sh

print () {
    if [ "$(uname)" = Darwin ]
    then
        printf "$1\n"
    else
        echo "$1"
    fi
}


# Distro-agnostic package managers
if [ "$(command -v flatpak)" >/dev/null != "" ]
then
    print "\e[32m> Upgrading flatpak packages...\e[39m"
    flatpak update -y 
    flatpak uninstall --unused -y
fi

if [ "$(command -v snap)" >/dev/null != "" ]
then
    print "\e[32m> Upgrading snap packages...\e[39m"
    sudo snap refresh
fi

if [ "$(command -v brew)" >/dev/null != "" ]
then
    print "\e[32m> Upgrading brew packages...\e[39m"
    if [ "$(uname)" = "Darwin" ]
    then
        brew upgrade --cask -y &&
        brew upgrade --greedy
    else 
        brew upgrade -y
    fi
    brew cleanup --prune=all
fi

# Debian-based
if [ "$(command -v apt)" >/dev/null != "" ]
then
    print "\e[32m> Upgrading apt packages...\e[39m"
    sudo apt update && sudo apt upgrade -y && sudo apt autoremove -y
    if [ "$(command -v deb-get)" >/dev/null != "" ]
    then
        print "\e[32m> Upgrading deb-get packages...\e[39m"
        deb-get update && deb-get upgrade
    fi
    if [ -x "$(command -v pacstall)" ]
    then
        print "\e[32m> Upgrading pacstall packages...\e[39m" && yes | sudo pacstall -P -Up
    fi
fi

# Arch-based
if [ "$(command -v pacman)" >/dev/null != "" ]
then
    print "\e[32m> Upgrading pacman packages...\e[39m"
    sudo pacman -Syyu --noconfirm
    if [ "$(command -v yay)" >/dev/null != "" ]
    then
        yay -Syyu --noconfirm
    fi
fi

# RPM-based
if [ "$(command -v dnf)" >/dev/null != "" ]
then
    print "\e[32m> Upgrading dnf packages...\e[39m"
    sudo dnf upgrade -y && sudo dnf autoremove -y
fi

# MacOS specific
if [ "$(uname)" = "Darwin" ]
then
    sudo softwareupdate -ia

    if [ "$(command -v mas)" >/dev/null != "" ]
    then
        updates=$(mas outdated)
        [ -n "$updates" ] && mas upgrade
    fi
fi
