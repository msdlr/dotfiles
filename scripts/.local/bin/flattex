#!/usr/bin/env sh

[ -z "$1" ] && exit
file="$1"
ret=0

if [ ! -f "$file" ]
then
    echo "File $1 not found!"
    exit 1
fi

if [ -z "$(command -v latexdiff)" ]
then   
    echo "latexdiff command not found!"
    exit 1
fi

out_name=${1%.tex}-flattened.tex

latexdiff --flatten "$1" "$1" > "$out_name" &&
tmp=$(mktemp) || return 1
if sed '/%DIF/d; /DIFscaledelfig/d' "$out_name" >"$tmp" && cp "$tmp" "$out_name"; then
    ret=0
else
    ret=1
fi
rm -f "$tmp"
exit $ret